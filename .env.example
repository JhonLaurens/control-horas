# Copia este archivo como .env y cambia la contraseña. El archivo .env NO se sube a Git.
POSTGRES_DB=controlhoras
POSTGRES_USER=controlhoras
POSTGRES_PASSWORD=cambia-esta-clave

# Puertos locales (solo 127.0.0.1)
FRONTEND_PORT=8092
BACKEND_PORT=8093

# Zona horaria usada para clasificar las horas (festivos, diurna/nocturna)
APP_ZONE=America/Bogota

# true = omite las pruebas durante `docker compose build` (más rápido)
SKIP_TESTS=false
